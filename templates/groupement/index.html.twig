{% extends 'base.html.twig' %}

{% block title %}Liste des groupements{% endblock %}

{% block body %}
<div class="container">
    <h1>Liste des groupements</h1>

    {% if groupements is empty %}
        <p>Aucun groupement enregistre.</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Telephone</th>
                    <th>Adresse</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            {% for groupement in groupements %}
                <tr>
                    <td>{{ groupement.nom }}</td>
                    <td>{{ groupement.tel ?? 'Non renseigne' }}</td>
                    <td>{{ groupement.adresse ?? 'Non renseignee' }}</td>
                    <td>
                        <a href="{{ path('app_groupement_show', {id: groupement.id}) }}">
                            Details
                        </a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <p><a href="{{ path('app_exercice') }}">Voir tous les exercices</a></p>
    <p><a href="{{ path('app_campagne') }}">Voir toutes les campagnes</a></p>
</div>
{% endblock %}
